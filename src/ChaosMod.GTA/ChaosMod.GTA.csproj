<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ChaosMod.GTA</AssemblyName>
    <RootNamespace>ChaosMod.GTA</RootNamespace>
    <!-- GTA5.exe is a 64-bit process; this must build x64, not AnyCPU. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />
    <PackageReference Include="LemonUI.SHVDN3" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChaosMod.Core\ChaosMod.Core.csproj" />
  </ItemGroup>

</Project>
